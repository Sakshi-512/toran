# Main domain gets a normal certificate. Business subdomains get certificates on demand, only
# after the app confirms the subdomain belongs to a real business (/internal/tls-check).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:8000/internal/tls-check
	}
}

(app) {
	encode zstd gzip
	# Internal endpoints are never reachable from the internet.
	@internal path /internal /internal/*
	respond @internal 404
	reverse_proxy app:8000
}

{$BASE_DOMAIN}, www.{$BASE_DOMAIN} {
	import app
}

# Any other host (that is, *.{$BASE_DOMAIN}) only gets a certificate if the ask check allows it.
https:// {
	tls {
		on_demand
	}
	import app
}

# Copy to .env and fill in. Never commit .env.
APP_NAME=
BASE_DOMAIN=
# production (default) or development. development turns off the Secure cookie flag for http://localhost.
APP_ENV=
SECRET_KEY=
DATABASE_URL=
# Folder for generated business sites (default data/sites).
SITES_DIR=
# Folder for daily log files, kept 30 days (default data/logs).
LOG_DIR=
# Folder for customer-test screenshots (default data/runs).
RUNS_DIR=
# Folder for owner photos and voice notes waiting to be processed (default data/uploads).
UPLOADS_DIR=

ANTHROPIC_API_KEY=
CLAUDE_MOCK=
CLAUDE_DAILY_SPEND_CAP_USD=

# none (default: voice off, owners type), mock (saved transcripts), or sarvam (Sarvam AI).
STT_PROVIDER=
STT_API_KEY=
# Real speech-to-text minutes per day (Asia/Kolkata); then owners are asked to type (default 120).
STT_DAILY_MINUTES_CAP=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=

GDDY_PAT=
# 1 = domain lookups use saved GoDaddy answers (tests/fixtures/gddy), separate from CLAUDE_MOCK.
GDDY_MOCK=

# Used only by Caddy: contact email for Let's Encrypt certificates.
ACME_EMAIL=
